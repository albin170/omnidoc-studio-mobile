# OmniDoc Studio Mobile Environment Configuration (Template)
# Copy to .env.local for local overrides. Never commit real secrets.

# Target environment: development | staging | production
VITE_APP_ENV=production

# Shared OmniDoc Studio FastAPI backend base URL (must include /api/v1)
# Production uses HTTPS; development emulator uses http://10.0.2.2:8000/api/v1
VITE_API_BASE_URL=https://omnidoc-studio-jet.vercel.app/api/v1
VITE_API_DEV_URL=http://10.0.2.2:8000/api/v1
VITE_API_STAGING_URL=https://omnidoc-studio-jet.vercel.app/api/v1
VITE_API_PROD_URL=https://omnidoc-studio-jet.vercel.app/api/v1

# Request timeout in milliseconds (default 30000; increase for large uploads on mobile networks)
VITE_API_TIMEOUT_MS=30000
