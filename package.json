{
  "name": "omnidoc-studio-mobile",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "OmniDoc Studio Mobile — Independent Capacitor + React + TypeScript Android application sharing the OmniDoc Studio FastAPI backend.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "cap:sync": "npm run build && npx cap sync android",
    "icons:generate": "node scripts/generate-android-assets.mjs",
    "e2e:backend": "node scripts/run-backend-e2e.mjs",
    "android:debug": "pwsh -Command \"if (-not $env:JAVA_HOME) { $env:JAVA_HOME='$HOME\\.gradle\\jdks\\temurin-21\\jdk-21.0.13+9' }; if (-not $env:ANDROID_HOME) { $env:ANDROID_HOME='$env:LOCALAPPDATA\\Android\\Sdk' }; Set-Location android; .\\gradlew.bat --no-daemon assembleDebug\"",
    "android:release": "pwsh -Command \"if (-not $env:JAVA_HOME) { $env:JAVA_HOME='$HOME\\.gradle\\jdks\\temurin-21\\jdk-21.0.13+9' }; if (-not $env:ANDROID_HOME) { $env:ANDROID_HOME='$env:LOCALAPPDATA\\Android\\Sdk' }; Set-Location android; .\\gradlew.bat --no-daemon assembleRelease\"",
    "android:bundle": "pwsh -Command \"if (-not $env:JAVA_HOME) { $env:JAVA_HOME='$HOME\\.gradle\\jdks\\temurin-21\\jdk-21.0.13+9' }; if (-not $env:ANDROID_HOME) { $env:ANDROID_HOME='$env:LOCALAPPDATA\\Android\\Sdk' }; Set-Location android; .\\gradlew.bat --no-daemon bundleRelease\""
  },
  "dependencies": {
    "@capacitor/android": "^7.4.4",
    "@capacitor/app": "^7.1.0",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.4",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/network": "^7.0.2",
    "@capacitor/preferences": "^7.0.2",
    "@capacitor/share": "^7.0.2",
    "@capacitor/splash-screen": "^7.0.3",
    "@capacitor/status-bar": "^7.0.3",
    "@datalens-tech/xlsx": "^0.20.3",
    "docx": "^9.5.1",
    "jszip": "^3.10.1",
    "lucide-react": "^0.511.0",
    "pako": "^2.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "pptxgenjs": "^4.0.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@eslint/js": "^9.27.0",
    "@tailwindcss/vite": "^4.1.7",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/pako": "^2.0.3",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.27.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vite": "^6.3.5",
    "vitest": "^5.1.2"
  },
  "overrides": {
    "image-size": "^2.2.0"
  }
}